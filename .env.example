# Optional. WhatsApp number in international format, digits only (no "+", spaces or dashes).
# Defaults to Enny's Kitchen's published line when left empty.
# Inlined at build time, so pass it as a Docker build arg (compose.yaml does this for you).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional. Host port that `docker compose up` publishes the site on. Defaults to 3000.
HOST_PORT=3000
